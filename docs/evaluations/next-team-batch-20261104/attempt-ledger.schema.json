{
  "format": "one JSON object per attempt; null measurements require unknown_reasons entries",
  "required": [
    "run_id",
    "attempt_id",
    "arm",
    "product",
    "task_id",
    "visit",
    "attempt_number",
    "packet_inventory_sha256",
    "entrypoint_revision",
    "source_policy_revision",
    "operator_context",
    "started_at",
    "finished_at",
    "status",
    "output_artifact",
    "resource_log_artifact",
    "source_bindings",
    "original_assessment_times",
    "current_observation_times",
    "requirements",
    "correct_assertions",
    "incorrect_assertions",
    "unknown_assertions",
    "missing_required_judgments",
    "useful_complete",
    "unfinished",
    "requests",
    "response_header_bytes",
    "response_body_bytes",
    "cache_read_bytes",
    "cache_write_bytes",
    "local_integrity_read_bytes",
    "parse_bytes",
    "hash_operations",
    "parse_operations",
    "serving_bytes",
    "storage_bytes",
    "elapsed_seconds",
    "operator_active_seconds",
    "cpu_seconds",
    "input_tokens",
    "output_tokens",
    "money",
    "cost_phase",
    "unknown_reasons"
  ],
  "status_values": [
    "completed",
    "incorrect",
    "unknown-scoped-complete",
    "unfinished",
    "setup-failed",
    "blocked",
    "refused"
  ],
  "requirements": "array of judgment, assertion, cited source hash/path/locator, scope, score and error reason; additional claims also scored",
  "requests": "counts by discovery/acquisition/conditional-304/change/fallback/audit/failure/retry/metadata; local and external separate",
  "cost_phase_values": [
    "preparation",
    "publisher-setup",
    "publisher-update",
    "publisher-recovery",
    "indexer-acquisition",
    "indexer-serving",
    "consumer-setup",
    "consumer-visit",
    "acceptance-review"
  ],
  "unknown_reasons": "map field -> why unmeasured; all unmeasured publisher costs remain null until D3/PD3",
  "failed_attempt_rule": "a later success never overwrites a prior attempt; IDs and raw outputs immutable"
}
