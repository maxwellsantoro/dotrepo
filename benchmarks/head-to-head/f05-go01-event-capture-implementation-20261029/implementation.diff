+            "stdout": "chosen output",
+            "stderr": "",
+            "exitCode": 1 if self.failure == "assertion-exit" else 0,
+            "error": "timeout" if self.failure == "main-deadline" else None,
+            "cancelled": self.failure == "cancelled",
