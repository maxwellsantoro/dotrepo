+    def call(self, argv, timeout, *, data=b"", limit, raw):
+        assert raw is True and timeout > 0
+        error, out, err = None, b"", b""
+        if argv[0] == "inspect":
+            self.inspect_count += 1
+            row = {
+                "Id": "a" * 64,
+                "Name": "/owned-container",
