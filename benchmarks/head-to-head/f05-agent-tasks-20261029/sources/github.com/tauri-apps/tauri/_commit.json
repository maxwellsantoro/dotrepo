  language=\"*\"\n+  ///           />\n+  ///       </dependentAssembly>\n+  ///   </dependency>\n   ///   <trustInfo xmlns=\"urn:schemas-microsoft-com:asm.v3\">\n   ///       <security>\n   ///           <requestedPrivileges>"}]}