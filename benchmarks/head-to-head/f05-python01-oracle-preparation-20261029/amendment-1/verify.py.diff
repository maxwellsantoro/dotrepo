+def sha(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def checked(path, row):
+    raw = path.read_bytes()
+    if len(raw) != row["bytes"] or sha(raw) != row["sha256"]:
+        raise ValueError("changed retained input: " + str(path))
+    return raw
+
+
+def discover_root(declared=None):
+    if declared is not None:
+        root = Path(declared).resolve()
+        if not (root / ".git").exists():
+            raise ValueError("declared repository has no Git metadata")
+        return root
+    return next(
+        (
+            p
+            for p in [Path.cwd(), *Path.cwd().parents, HERE, *HERE.parents]
+            if (p / ".git").exists()
+        ),
+        None,
     )
 
 
+def git(root, *args):
+    value = subprocess.run(
+        ["git", "--no-pager", "-C", str(root), *args],
+        stdout=subprocess.PIPE,
+        stderr=subprocess.PIPE,
+        timeout=10,
+        check=False,
+    )
+    if value.returncode:
+        raise ValueError("read-only historical Git lookup failed")
+    return value.stdout
+
+
+def verify(*, packet=None, repo_root=None, no_repository=False, archive=None, parent=None):
+    packet = HERE if packet is None else Path(packet)
+    root = None if no_repository else discover_root(repo_root)
+    raw_parent = (packet / "parent-FREEZE.json").read_bytes()
+    if sha(raw_parent) != PARENT_FREEZE_SHA:
+        raise ValueError("changed original freeze")
+    original = json.loads((packet / "parent-source-bindings.json").read_bytes())
+    resolution = json.loads((packet / "input-resolution.json").read_bytes())
+    originals = {row["path"]: row for row in original["files"]}
+    historical, observed = 0, []
+    for row in resolution["rows"]:
+        old = originals[row.get("path", row.get("originalLocator"))]
+        if row["sha256"] != old["sha256"] or row["bytes"] != old["bytes"]:
+            raise ValueError("input snapshot differs from original binding")
+        if row["resolution"] == "optional-explicit-full-archive":
+            continue
+        checked(packet / row["snapshot"], row)
+        if row["resolution"] == "retained-snapshot-and-matching-git-base":
+            if row["gitCommit"] != BASE:
+                raise ValueError("changed historical base")
+            if root is not None:
+                blob = git(root, "rev-parse", BASE + ":" + row["path"]).decode().strip()
+                if blob != row["gitBlob"]:
+                    raise ValueError("historical Git object mismatch")
+                body = git(root, "cat-file", "blob", blob)
+                if sha(body) != row["sha256"] or len(body) != row["bytes"]:
+                    raise ValueError("historical bytes mismatch")
+            historical += 1
+        elif row["resolution"] == "retained-observed-working-tree-snapshot-not-git-base":
+            observed.append(
+                {"path": row["path"], "sha256": row["sha256"], "attributedToBase": False}
+            )
+        else:
+            raise ValueError("unknown input resolution")
+    archive_result = {
+        "performed": False,
+        "reason": "no --archive supplied; current external archive not audited",
+    }
+    if archive is not None:
+        row = next(
