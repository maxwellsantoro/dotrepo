+def isolation_options(row, config):
+    """Compare only the reviewed create policy and absent additive grants.
+
+    Docker serializes absent additive lists as null or []; neither permits a
+    grant. Explicit false privilege is required. No new namespace mode is added.
+    """
+    host = row["HostConfig"]
+    require(host["Privileged"] is False, "privileged container")
+    for key in ("CapAdd", "Devices", "DeviceRequests", "DeviceCgroupRules", "Binds", "VolumesFrom"):
+        require(
+            key in host and (host[key] is None or host[key] == []), "added/missing grant: " + key
+        )
+    require(
+        re.fullmatch(r"[1-9][0-9]*:[1-9][0-9]*", config["containerUser"]) is not None,
+        "configured user must be nonroot UID:GID",
+    )
+    require(
+        host["Ulimits"] == [{"Name": "nofile", "Soft": 1024, "Hard": 1024}], "nofile limit mismatch"
+    )
+    logs = host["LogConfig"]
+    require(
+        logs["Type"] == "none" and (logs["Config"] is None or logs["Config"] == {}),
+        "log-driver/options mismatch",
+    )
+    health = row["Config"]["Healthcheck"]
+    require(
+        isinstance(health, dict)
+        and health.get("Test") == ["NONE"]
+        and set(health)
+        <= {"Test", "Interval", "Timeout", "Retries", "StartPeriod", "StartInterval"},
+        "healthcheck not disabled",
+    )
+    require(
+        all(key == "Test" or type(value) is int and value == 0 for key, value in health.items()),
+        "disabled healthcheck option mismatch",
+    )
 
 
